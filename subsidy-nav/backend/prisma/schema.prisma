generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MunicipalityType {
  CITY
  WARD
  TOWN
  VILLAGE
}

enum SubsidyStatus {
  UPCOMING
  ACTIVE
  ENDED
}

enum TargetAudience {
  INDIVIDUAL
  CORPORATION
  FARMER
  NONPROFIT
  STARTUP
  ELDERLY
  CHILD
  DISABLED
}

enum InquiryType {
  GENERAL
  MATCHING
  APPLICATION_SUPPORT
  DOCUMENT_CREATION
  OTHER
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Prefecture {
  id            Int            @id @default(autoincrement())
  code          String         @unique @db.VarChar(2)
  name          String         @db.VarChar(10)
  municipalities Municipality[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("prefectures")
}

model Municipality {
  id             Int              @id @default(autoincrement())
  code           String           @unique @db.VarChar(5)
  name           String           @db.VarChar(50)
  type           MunicipalityType
  prefectureId   Int
  prefecture     Prefecture       @relation(fields: [prefectureId], references: [id])
  subsidies      Subsidy[]
  scrapeLogs     ScrapeLog[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("municipalities")
}

model SubsidyCategory {
  id          Int       @id @default(autoincrement())
  slug        String    @unique @db.VarChar(50)
  name        String    @db.VarChar(50)
  description String?
  subsidies   Subsidy[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("subsidy_categories")
}

model Subsidy {
  id               Int              @id @default(autoincrement())
  title            String           @db.VarChar(200)
  description      String
  targetAudiences  TargetAudience[]
  maxAmount        BigInt?
  subsidyRate      Float?
  applicationStart DateTime?
  applicationEnd   DateTime?
  status           SubsidyStatus    @default(ACTIVE)
  municipalityId   Int?
  municipality     Municipality?    @relation(fields: [municipalityId], references: [id])
  categoryId       Int?
  category         SubsidyCategory? @relation(fields: [categoryId], references: [id])
  sourceUrl        String?
  isNational       Boolean          @default(false)
  isStartupFriendly Boolean         @default(false)
  requirements     String?
  documentUrl      String?
  contactInfo      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("subsidies")
}

model AlertPreference {
  id               Int              @id @default(autoincrement())
  email            String           @db.VarChar(255)
  prefectureCodes  String[]
  municipalityCodes String[]
  audiences        TargetAudience[]
  categorySlugs    String[]
  isVerified       Boolean          @default(false)
  verificationToken String?         @unique
  tokenExpiresAt   DateTime?
  isActive         Boolean          @default(true)
  lastNotifiedAt   DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("alert_preferences")
}

model ConsultingInquiry {
  id           Int           @id @default(autoincrement())
  name         String        @db.VarChar(100)
  company      String?       @db.VarChar(200)
  email        String        @db.VarChar(255)
  phone        String?       @db.VarChar(20)
  inquiryType  InquiryType
  message      String
  status       InquiryStatus @default(NEW)
  adminNote    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("consulting_inquiries")
}

model ScrapeLog {
  id             Int          @id @default(autoincrement())
  municipalityId Int
  municipality   Municipality @relation(fields: [municipalityId], references: [id])
  startedAt      DateTime
  completedAt    DateTime?
  scraped        Int          @default(0)
  saved          Int          @default(0)
  errors         String[]
  success        Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@map("scrape_logs")
}
