generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Prefecture {
  id           Int            @id @default(autoincrement())
  code         String         @unique // JIS code e.g. "13"
  name         String         // 東京都
  nameKana     String         // トウキョウト
  municipalities Municipality[]
  subsidies    Subsidy[]
  alertPrefs   AlertPreference[]

  @@map("prefectures")
}

model Municipality {
  id           Int       @id @default(autoincrement())
  prefectureId Int
  code         String    @unique // JIS code e.g. "13101"
  name         String    // 千代田区
  nameKana     String    // チヨダク
  type         MunicipalityType
  prefecture   Prefecture @relation(fields: [prefectureId], references: [id])
  subsidies    Subsidy[]
  alertPrefs   AlertPreference[]

  @@map("municipalities")
}

enum MunicipalityType {
  CITY    // 市
  WARD    // 区
  TOWN    // 町
  VILLAGE // 村
}

model SubsidyCategory {
  id       Int       @id @default(autoincrement())
  slug     String    @unique
  name     String    // 子育て支援
  icon     String    // emoji or icon name
  subsidies Subsidy[]
  alertPrefs AlertPreference[]

  @@map("subsidy_categories")
}

model Subsidy {
  id               Int              @id @default(autoincrement())
  title            String
  description      String           @db.Text
  detail           String?          @db.Text
  categoryId       Int
  prefectureId     Int?
  municipalityId   Int?
  isNational       Boolean          @default(false)
  maxAmount        BigInt?          // 最大補助額(円)
  subsidyRate      Float?           // 補助率(0.0-1.0)
  targetAudience   TargetAudience[]
  applicationStart DateTime?
  applicationEnd   DateTime?        // 締め切り
  announcedAt      DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  sourceUrl        String
  status           SubsidyStatus    @default(ACTIVE)
  tags             String[]
  requirements     String?          @db.Text
  howToApply       String?          @db.Text

  category     SubsidyCategory @relation(fields: [categoryId], references: [id])
  prefecture   Prefecture?     @relation(fields: [prefectureId], references: [id])
  municipality Municipality?   @relation(fields: [municipalityId], references: [id])

  @@index([status, applicationEnd])
  @@index([municipalityId])
  @@index([prefectureId])
  @@index([categoryId])
  @@map("subsidies")
}

enum SubsidyStatus {
  UPCOMING // 公募前
  ACTIVE   // 受付中
  ENDED    // 終了
}

enum TargetAudience {
  INDIVIDUAL    // 個人
  CORPORATION   // 法人・中小企業
  FARMER        // 農業者
  NONPROFIT     // NPO・非営利団体
  STARTUP       // 創業者・スタートアップ
  ELDERLY       // 高齢者
  CHILD         // 子育て世帯
  DISABLED      // 障害者・障害者雇用
}

model AlertPreference {
  id                   Int      @id @default(autoincrement())
  email                String
  prefectureIds        Int[]
  municipalityIds      Int[]
  categoryIds          Int[]
  targetAudiences      TargetAudience[]
  notifyNewSubsidy     Boolean  @default(true)
  deadlineReminderDays Int      @default(14) // 締め切り何日前に通知
  isVerified           Boolean  @default(false)
  verifyToken          String?  @unique
  createdAt            DateTime @default(now())

  prefectures    Prefecture[]    @relation
  municipalities Municipality[]  @relation
  categories     SubsidyCategory[] @relation

  @@index([email])
  @@map("alert_preferences")
}

model ConsultingInquiry {
  id          Int             @id @default(autoincrement())
  name        String
  email       String
  phone       String?
  companyName String?
  inquiryType InquiryType
  message     String          @db.Text
  status      InquiryStatus   @default(NEW)
  createdAt   DateTime        @default(now())
  respondedAt DateTime?

  @@map("consulting_inquiries")
}

enum InquiryType {
  SUBSIDY_SEARCH    // 補助金・助成金の探し方
  APPLICATION_HELP  // 申請サポート
  CONSULTING        // 事業コンサルティング
  OTHER             // その他
}

enum InquiryStatus {
  NEW         // 新規
  IN_PROGRESS // 対応中
  RESOLVED    // 完了
}
